{
  "name": "cuadra",
  "version": "2.0.0",
  "private": true,
  "description": "Cuadra: control de gastos frente a tu presupuesto mensual (React + Node)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "dev:local": "concurrently -k -n api,web -c magenta,cyan \"node --watch-path=server --watch-path=shared --watch-path=presupuesto-inicial.js server/index.js\" \"vite --mode servidor\"",
    "app": "vite build --mode servidor && node server/index.js",
    "start": "node server/index.js",
    "red": "node server/index.js --red"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "express": "^5.3.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
